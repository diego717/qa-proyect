# Copy to .env for local runs. Never commit .env. In CI these come from repository secrets.

# Where the app under test lives (staging).
E2E_BASE_URL=

# Token for POST <resetPath> (header x-test-reset-token). Leave empty if there is no reset endpoint.
E2E_RESET_TOKEN=

# One block per role listed in qa.config.ts. Role "power-user" becomes E2E_POWER_USER_*.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Only if the test user has MFA with an authenticator app (base32 secret).
E2E_USER_TOTP_SECRET=

# "only" runs just the quarantined tests (used by the non-blocking CI job).
E2E_QUARANTINE_MODE=
